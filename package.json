{
  "name": "web-komorebi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --recursive --filter ./apps/* build",
    "test": "pnpm --recursive --filter ./apps/* test",
    "typecheck": "pnpm --recursive --filter ./apps/* typecheck"
    ,"db:dev": "docker compose -f docker-compose.dev.yml up -d"
    ,"db:migrate": "pnpm --filter api prisma:migrate"
    ,"db:seed": "pnpm --filter api prisma:seed"
  }
}
